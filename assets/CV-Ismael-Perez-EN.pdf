<!-- Versión en inglés del CV - Generada para GitHub Pages -->
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Ismael Pérez - Game Designer CV (EN)</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: 'Helvetica Neue', Arial, sans-serif; line-height: 1.6; color: #333; padding: 2rem; max-width: 800px; margin: 0 auto; }
        h1 { font-size: 2.5rem; color: #ff0069; margin-bottom: 0.5rem; }
        .subtitle { color: #96ff00; font-size: 1.2rem; margin-bottom: 2rem; }
        .section { margin-bottom: 2rem; padding-top: 1rem; border-top: 2px solid #333; }
        h2 { font-size: 1.5rem; color: #ff0069; margin-bottom: 1rem; }
        .contact-info { background: #f4f4f4; padding: 1.5rem; border-radius: 8px; margin-bottom: 1.5rem; }
        .contact-info p { margin: 0.5rem 0; color: #333; }
        .experience-item { margin-bottom: 1.5rem; padding: 1rem; background: #f9f9f9; border-radius: 6px; }
        .year { color: #ff0069; font-weight: bold; display: block; margin-bottom: 0.3rem; }
        .job-title { font-size: 1.2rem; font-weight: bold; color: #333; margin-bottom: 0.3rem; }
        .company { color: #666; font-style: italic; margin-bottom: 0.5rem; }
        .skills-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1rem; }
        .skill-item { background: #f4f4f4; padding: 1rem; border-radius: 6px; border-left: 3px solid #ff0069; }
        .software-grid { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 1rem; }
        .software-item { background: #1a1a1a; padding: 0.5rem 1rem; border-radius: 4px; color: #fff; font-size: 0.85rem; border: 1px solid #333; }
    </style>
</head>
<body>
    <h1>ISMAEL PÉREZ</h1>
    <p class="subtitle">Game Designer</p>

    <div class="contact-info">
        <p><strong>Email:</strong> ismaeluniperez@gmail.com</p>
        <p><strong>ArtStation:</strong> <a href="https://www.artstation.com/ismaelperezrodriguez" target="_blank">ismaelperezrodriguez.artstation.com</a></p>
        <p><strong>Location:</strong> Madrid, Spain | Available for new projects</p>
    </div>

    <div class="section">
        <h2>PROFESSIONAL EXPERIENCE</h2>
        
        <div class="experience-item">
            <span class="year">2024 - Present (In Progress)</span>
            <p class="job-title">Bachelor's Degree in Game Design</p>
            <p class="company">Universidad Europea de Madrid • 4th Year</p>
            <p>Focusing on systems design, level design, UX and documentation of playable projects. Currently developing advanced game mechanics and narrative systems.</p>
        </div>

        <div class="experience-item">
            <span class="year">2022 - 2024 (Completed)</span>
            <p class="job-title">CFGS in 3D Animation, Games & Interactive Environments</p>
            <p class="company">Universidad Europea de Madrid</p>
            <p>Training in environment creation, animation and interactive production. Specialization in world-building and narrative design.</p>
        </div>

        <div class="experience-item">
            <span class="year">2022 - 2023 (Internship)</span>
            <p class="job-title">Design Internship</p>
            <p class="company">Creative Rainbow</p>
            <p>Internship to complete CFGS program. Worked on game mechanics and user experience design.</p>
        </div>
    </div>

