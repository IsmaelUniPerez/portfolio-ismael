<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <title>Ismael Pérez - Game Designer</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="stylesheet" href="styles.css" />
</head>
<body>

  <!-- SECTION 01: INICIO -->
  <section id="inicio">
    <div class="hero">
      <h1>JUGADOR Y<br><span>DISEÑADOR</span><br>JUNTOS PARA<br><span>CREAR MUNDOS</span><br><span style="color:#ff0069; font-size: 3em; line-height: 1;">INCREÍBLES.</span></h1>
      <p class="subtext">Diseño sistemas, espacios y relatos para que cada jugador encuentre su propia forma de habitarlos.</p>
    </div>

    <!-- PROYECTOS SLIDER -->
    <div class="slider-container">
      <div id="project-slider" class="slider">
        <!-- Proyecto 1: Panzerdrifter -->
        <div class="slide">
          <div class="image-wrapper">
            <img src="assets/PanzerdrifterCaptura.png" alt="Panzerdrifter" />
            <span class="arrow-left">←</span>
            <span class="arrow-right">→</span>
          </div>
          <div class="slide-info">
            <h3>PANZERDRIFTER</h3>
            <p>Combat racing • 1º año</p>
          </div>
        </div>

        <!-- Proyecto 2: Mentirosos -->
        <div class="slide">
          <div class="image-wrapper">
            <img src="assets/MentirososCaptura.png" alt="Mentirosos" />
            <span class="arrow-left">←</span>
            <span class="arrow-right">→</span>
          </div>
          <div class="slide-info">
            <h3>MENTIROSOS</h3>
            <p>Card game • 2º año</p>
          </div>
        </div>

        <!-- Proyecto 3: Teeny Tiny Squids -->
        <div class="slide">
          <div class="image-wrapper">
            <img src="assets/TTSICaptura.png" alt="Teeny Tiny Squids Invasion" />
            <span class="arrow-left">←</span>
            <span class="arrow-right">→</span>
          </div>
          <div class="slide-info">
            <h3>TEENY TINY SQUIDS INVASION</h3>
            <p>Tower defense • 3º año</p>
          </div>
        </div>

        <!-- Proyecto 4: Bar Espacial -->
        <div class="slide">
          <div class="image-wrapper">
            <img src="assets/BarEspacialCaptura.png" alt="Bar Espacial" />
            <span class="arrow-left">←</span>
            <span class="arrow-right">→</span>
          </div>
          <div class="slide-info">
            <h3>BAR ESPACIAL</h3>
            <p>Proyecto individual • TFC</p>
          </div>
        </div>
      </div>
    </div>

    <!-- NAVEGACIÓN -->
    <nav class="navbar">
      <a href="#inicio" class="nav-link active">INICIO</a>
      <a href="#sobre-mi" class="nav-link">SOBRE MÍ</a>
      <a href="#cv" class="nav-link">CV + CAPABILITIES</a>
      <a href="#contacto" class="nav-link">CONTACTO</a>
    </nav>

    <!-- SCROLL TEXT -->
    <div class="scroll-indicator">Scroll to explore</div>
  </section>

  <!-- SECTION 02: SOBRE MÍ -->
  <section id="sobre-mi" class="about">
    <div class="profile-photo">
      <img src="assets/ImagenIsmael.png" alt="Ismael Pérez" />
      <span class="name-tag">ISMAEL / GAME DESIGNER</span>
    </div>
    <div class="about-text">
      <p class="chapter-label">02 / SOBRE MÍ</p>
      <h1>Diseñar es<br><span style="color:#ff0069;">hacer preguntas</span><br>con forma.</h1>

      <p>Soy Ismael Pérez, diseñador de videojuegos de 23 años. Me interesa convertir ideas en sistemas jugables claros, con espacio para la sorpresa y la expresión del jugador.</p>

      <p class="subtext">Cursando 4º de Diseño de Videojuegos en la Universidad Europea de Madrid y disponible para nuevos proyectos.</p>
    </div>
  </section>

  <!-- SECTION 03: CV + CAPABILITIES -->
  <section id="cv" class="cv">
    <div class="header">
      <h1 class="main-title">Lo que llevo<br><span style="color:#ff0069;">a la mesa.</span></h1>
      <div class="download-button">
        <span>Descargar CV</span>
        <span>PDF · próximamente</span>
      </div>
    </div>

    <!-- EXPERIENCIA -->
    <div class="experience">
      <div class="exp-item">
        <span class="year">2022</span>
        <div class="content">
          <h3>Prácticas de diseño</h3>
          <p>Creative Rainbow</p>
          <p>Prácticas realizadas para completar el CFGS de Animaciones 3D, Juegos y Entornos Interactivos.</p>
        </div>
      </div>

      <div class="exp-item">
        <span class="year">En curso</span>
        <div class="content">
          <h3>Grado en Diseño de Videojuegos</h3>
          <p>Universidad Europea de Madrid • 4º año</p>
          <p>Diseño de sistemas, niveles, UX y documentación de proyectos jugables.</p>
        </div>
      </div>

      <div class="exp-item">
        <span class="year">Completado</span>
        <div class="content">
          <h3>CFGS Animaciones 3D</h3>
          <p>Juegos y Entornos Interactivos</p>
          <p>Formación en creación de entornos, animación y producción interactiva.</p>
        </div>
      </div>
    </div>

    <!-- TOOLKIT -->
    <div class="toolkit">
      <h3>Toolkit / always learning</h3>

      <!-- Progress Bars -->
      <div class="skill-item">
        <span>Diseño de sistemas</span>
        <div class="progress-bar"><div class="fill" style="width:96%;"></div></div>
        <span style="color:#96ff00;">96%</span>
      </div>
      <div class="skill-item">
        <span>Diseño de niveles</span>
        <div class="progress-bar"><div class="fill" style="width:88%;"></div></div>
        <span style="color:#96ff00;">88%</span>
      </div>
      <div class="skill-item">
        <span>Prototipado</span>
        <div class="progress-bar"><div class="fill" style="width:92%;"></div></div>
        <span style="color:#96ff00;">92%</span>
      </div>
      <div class="skill-item">
        <span>Documentación GDD</span>
        <div class="progress-bar"><div class="fill" style="width:90%;"></div></div>
        <span style="color:#96ff00;">90%</span>
      </div>

      <!-- ESPECIAL INTERÉS -->
      <div class="special-interest">
        <h3>ESPECIAL INTERÉS</h3>
        <p>Worldbuilding y narrativa · Modelado y texturizado 3D · Diseño de juegos · <strong>Artista de Escenarios</strong></p>
      </div>

      <!-- CAPACIDADES -->
      <div class="capacidades">
        <h3>CAPACIDADES</h3>
        <p>Documentación GDD · Programación C# · UX/UI · Mecánicas y sistemas · Animación · Rigging</p>
      </div>

      <!-- SOFTWARE -->
      <div class="software-grid">
        <span>Unity</span><span>3ds Max</span><span>Maya</span><span>ZBrush</span><span>Houdini</span><span>C#</span><span>Substance Painter</span><span>Substance Designer</span><span>Photoshop</span><span>Illustrator</span><span>Blender</span><span>Figma</span>
      </div>
    </div>
  </section>

  <!-- SECTION 04: CONTACTO -->
  <section id="contacto" class="contact">
    <p class="chapter-label">CONTACTO</p>
    <h1>Hablemos de<br><span style="font-size: 2.5em; line-height: 1;">algo increíble.</span></h1>

    <div class="email-button">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M20 4H4c-1.1 0-1.99.9-1.99 2L5 20c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4v14H4V8h16z" fill="none"/><path d="M0 0h24v24H0z" fill="none"/></svg>
      <span>ismaeluniperez@gmail.com</span>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M8.59 16.59L13.17 12 8.59 7.41 10 6l6 6-6 6-1.41-1.41z"/></svg>
    </div>
  </section>

  <script src="script.js"></script>
</body>
</html>
